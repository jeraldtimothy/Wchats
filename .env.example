# Copy to .env (repo root). Never commit real keys.

# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wchats
# Used by `pnpm test` (created automatically if missing)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wchats_test
PORT=3000
# Public origin of the API as the browser sees it (Vite proxies /api in dev)
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# --- Google OAuth (optional; the Google button is hidden when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM providers (a provider's models are hidden when its key is unset) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional base URL overrides (proxies, gateways)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

# Dev/demo only: set to 1 to answer every model with a built-in simulator
# (no network calls; replies, usage and charges are simulated). Keep 0 in production.
LLM_SIMULATION=0

# --- Billing ---
# Multiplier applied to provider cost
MARKUP=1.25
# Credit granted to each new sign-up's personal account, in USD
SIGNUP_CREDIT_USD=0

# --- Storage ---
# Where uploads are kept in development (defaults to apps/api/storage)
STORAGE_DIR=

# --- Misc ---
SIMGEN_URL=https://example.com/simgen
LOG_LEVEL=info
